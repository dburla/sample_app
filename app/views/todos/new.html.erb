<% provide(:title, "New Todo") %>

<div class="container">
  <div class="row">
    <div class="col-md-6 col-md-offset-3">
      <h1>Add New Todo</h1>
      
      <%= form_for(@todo, local: true) do |f| %>
        <% if @todo.errors.any? %>
          <div class="alert alert-danger">
            <h4><%= pluralize(@todo.errors.count, "error") %> prohibited this todo from being saved:</h4>
            <ul>
              <% @todo.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>
        
        <div class="form-group">
          <%= f.label :text, "Todo Description" %>
          <%= f.text_area :text, class: "form-control", rows: 4, placeholder: "What needs to be done?" %>
        </div>
        
        <div class="form-group">
          <%= f.submit "Create Todo", class: "btn btn-primary" %>
          <%= link_to "Cancel", todos_path, class: "btn btn-default" %>
        </div>
      <% end %>
    </div>
  </div>
</div>